{
  // default: true
  "enableMod": true,
  // default: true
  "showHud": true,
  // default: true
  "showHudWhenBlind": true,
  // default: false
  "showHealingParticles": false,
  // default: true
  "showDamageParticles": true,
  // default: true
  "showBar": false,
  // default: true
  "showSecondaryBar": true,
  // default: true
  "showBackgroundBar": true,
  // default: true
  "showName": true,
  // default: true
  "showHealth": true,
  // default: true
  "showArmor": true,
  // default: false
  "showModName": false,
  // default: false
  "showHealthDecimals": false,
  // values: CURRENT_HEALTH, MAX_HEALTH, BOTH, default: BOTH
  "healthTextFormat": "BOTH",
  // default: true
  "dynamicHeartTexture": true,
  // values: VANILLA, DEFAULT, ROUNDED, GRADIENT, MINIMALIST, MODERN, default: DEFAULT
  "barStyle": "DEFAULT",

  // min: 0, max: 2147483647, default: 60
  "distance": 1,
  // min: -Infinity, max: Infinity, default: 0.0
  "xValue": 0.0,
  // min: -Infinity, max: Infinity, default: 0.0
  "yValue": 145.0,
  // min: 0.0, max: Infinity, default: 1.0
  "scale": 0.7,
  // min: 0, max: 2147483647, default: 40
  "hideDelay": 40,
  // values: TOP_LEFT, TOP_CENTER, TOP_RIGHT, BOTTOM_LEFT, BOTTOM_CENTER, BOTTOM_RIGHT, default: TOP_LEFT
  "position": "BOTTOM_CENTER",
  // min: 0.0, max: Infinity, default: 1.0
  "particleScale": 1.0,

  // min: 0, max: 100, default: 0
  "hudBackgroundOpacity": 0,
  // min: 7, width: 7, default: #000000
  "hudBackgroundColor": "#000000",
  // min: 7, width: 7, default: #808080
  "backgroundBarColor": "#808080",
  // min: 7, width: 7, default: #00ff00
  "passiveColor": "#00ff00",
  // min: 7, width: 7, default: #008000
  "passiveColorSecondary": "#008000",
  // min: 7, width: 7, default: #ff0000
  "hostileColor": "#ff0000",
  // min: 7, width: 7, default: #800000
  "hostileColorSecondary": "#800000",
  // min: 7, width: 7, default: #0000ff
  "neutralColor": "#0000ff",
  // min: 7, width: 7, default: #000080
  "neutralColorSecondary": "#000080",
  // min: 7, width: 7, default: #5555ff
  "modNameColor": "#5555ff",
  // min: 7, width: 7, default: #00fc00
  "healingParticleColor": "#00fc00",
  // min: 7, width: 7, default: #fcfcfc
  "damageParticleColor": "#fcfcfc",

  // default: true
  "showInvisibleEntities": false,
  // default: false
  "showBosses": true,
  // default: []
  "blacklist": [],
  // default: []
  "barBlacklist": [],
  // default: []
  "numberParticleBlacklist": []
}
